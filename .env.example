# 案例理解：纯文本即可，例如 LongCat（/v1/chat/completions）
PLANNER_MODEL_BASE_URL=https://api.longcat.chat/openai/v1
PLANNER_MODEL_API_KEY=
PLANNER_MODEL_NAME=LongCat-2.5-Preview

# Midscene 手机执行：必须是 Midscene 支持的视觉模型（豆包 Seed、Qwen3、Gemini 等），不能用 LongCat
# 文档：https://midscenejs.com/model-common-config.html
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

PORT=3920
